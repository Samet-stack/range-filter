// Original: Range Filter Trend [QuantAlgo], © QuantAlgo.
// Manual-trading indicator, 2026-10-21: same filter engine as Range Filter Spot V4.
// BUY at the first up step when no move is open; FIN at the first down step or
// after a prolonged flat. FIN is information, not an order. No target, no stop:
// exits are the trader's decision. The live bar answers "what now?": ACHAT (buy
// window open), ACHAT ? (the forming bar closes into a BUY if it holds), EN COURS
// (too late to enter), FIN ?, PAS D'ACHAT, ATTENTE, with the exact close levels
// that trigger BUY or FIN. Optional zones show each past move (best gain, worst
// dip). The verdict asks one directional question: after a BUY,
// does +x% come before -x% more often than from any bar? (Reaching +x% alone is
// not evidence: BUYs come in volatile phases, where -x% also comes more often.)
// This script reads no wallet and places no order.
// No affiliation implied.
//@version=6
indicator("Range Filter Manuel", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_boxes_count = 500)

const string G_CORE = "1. Filtre"
const string G_ACT = "2. Quand acheter"
const string G_TRADE = "2b. Mon trade"
const string G_STATS = "3. Statistiques"
const string G_VIS = "4. Affichage"
const string SZ_S = "Petit"
const string SZ_M = "Normal"
const string SZ_L = "Grand"

periodIn = input.int(100, "Periode", minval = 2, maxval = 1000, group = G_CORE)
multIn = input.float(3.0, "Multiplicateur", minval = 0.5, step = 0.25, group = G_CORE, tooltip = "Plus petit = BUY plus tot, mais plus de faux departs.")
atrLen = input.int(14, "Periode ATR", minval = 2, maxval = 200, group = G_CORE)
atrFloor = input.float(0.25, "Largeur minimale / ATR", minval = 0.0, maxval = 3.0, step = 0.05, group = G_CORE)
rangeBars = input.int(20, "Bougies plates = fin du mouvement", minval = 1, maxval = 500, group = G_CORE)

entryBars = input.int(0, "Fenetre d'achat : bougies max apres le BUY (0 = pas de limite)", minval = 0, maxval = 500, group = G_ACT, tooltip = "Par defaut, seule la distance au prix du BUY ferme la fenetre : acheter au prix du BUY reste le meme trade, meme 10 bougies plus tard.")
lateMaxPct = input.float(1.5, "Trop tard si deja a +x % du BUY", minval = 0.1, step = 0.25, group = G_ACT, tooltip = "Si le prix est deja monte de plus de x % depuis le BUY, la fenetre se ferme.")
showWindow = input.bool(true, "Fond vert = fenetre d'achat", group = G_ACT)
showLevels = input.bool(true, "Niveaux de cloture : BUY si > / FIN si <", group = G_ACT, tooltip = "Le BUY (ou la FIN) est confirme si la bougie cloture au-dela de ce niveau. C'est le calcul exact du filtre.")
alertPreview = input.bool(false, "Alerte aussi quand un BUY se forme (avant la cloture)", group = G_ACT, tooltip = "Previent plus tot, mais le BUY peut disparaitre si le prix redescend avant la cloture.")

walletIn = input.float(0.0, "Wallet (devise de cotation, 0 = masque)", minval = 0.0, group = G_TRADE, tooltip = "Saisi a la main : le script ne lit pas ton wallet.")
sizePct = input.float(20.0, "% du wallet par trade", minval = 0.1, maxval = 100.0, step = 1.0, group = G_TRADE)
feeRtPct = input.float(0.20, "Frais aller-retour (%)", minval = 0.0, step = 0.01, group = G_TRADE, tooltip = "Frais + spread, achat et vente ensemble. Hyperliquid spot : taker 0,07 % par cote, plus le spread. Sert au resultat apres frais.")

statsStart = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Stats depuis", group = G_STATS)
thr1 = input.float(2.0, "Seuil 1 (%)", minval = 0.1, step = 0.5, group = G_STATS)
thr2 = input.float(3.0, "Seuil 2 (%) = seuil du verdict", minval = 0.1, step = 0.5, group = G_STATS, tooltip = "Verdict : apres un BUY, +X % arrive-t-il avant -X % plus souvent qu'en achetant a n'importe quelle bougie ?")
thr3 = input.float(5.0, "Seuil 3 (%)", minval = 0.1, step = 0.5, group = G_STATS)
dirCap = input.int(300, "Horizon max du test (bougies)", minval = 10, maxval = 1000, group = G_STATS, tooltip = "Un depart sans +X % ni -X % au bout de cet horizon n'est pas compte.")

colUp = input.color(#00c896, "Hausse", group = G_VIS)
colDown = input.color(#ff4d4d, "Baisse", group = G_VIS)
colFlat = input.color(#8a8f98, "Plat", group = G_VIS)
lineWidth = input.int(3, "Epaisseur du filtre", minval = 1, maxval = 8, group = G_VIS)
textSizeIn = input.string(SZ_M, "Taille du texte", options = [SZ_S, SZ_M, SZ_L], group = G_VIS)
showCloud = input.bool(false, "Nuage de tendance (entre filtre et prix)", group = G_VIS)
colorBars = input.bool(false, "Colorer les bougies selon le filtre", group = G_VIS)
showBands = input.bool(false, "Bande haute et seuil d'inversion", group = G_VIS)
showZones = input.bool(false, "Zones des mouvements (max atteint / pire baisse)", group = G_VIS, tooltip = "Vert : du prix du BUY au plus haut atteint. Rouge : du prix du BUY au plus bas atteint. Figees a chaque cloture.")
zonesKept = input.int(30, "Zones : derniers mouvements affiches", minval = 1, maxval = 250, group = G_VIS)
showLabels = input.bool(true, "Etiquettes BUY / FIN", group = G_VIS)
showTag = input.bool(true, "Etiquette ACHAT / ATTENTE a droite du prix", group = G_VIS)
showLive = input.bool(true, "Panneau : que faire maintenant", group = G_VIS)
showStats = input.bool(false, "Panneau detaille : ce qu'ont donne les BUY", group = G_VIS)

float feeRt = feeRtPct / 100.0
string szMain = textSizeIn == SZ_S ? size.small : textSizeIn == SZ_L ? size.large : size.normal
string szMinor = textSizeIn == SZ_S ? size.tiny : textSizeIn == SZ_L ? size.normal : size.small
string szBig = textSizeIn == SZ_S ? size.normal : textSizeIn == SZ_L ? size.huge : size.large
// Panel colours follow the chart theme, so text stays readable on light and dark charts.
color fg = chart.fg_color
color fgMuted = color.new(chart.fg_color, 45)
color panelBg = color.new(chart.bg_color, 5)
color panelLine = color.new(chart.fg_color, 85)
color colAmber = #f0b429
color colNeutral = #5d6470

if barstate.isfirst and not chart.is_standard
    runtime.error("Utiliser des bougies standard : Heikin Ashi, Renko, etc. faussent les prix.")

// === ENGINE (identical to Range Filter Spot V4) ===
float rawRange = math.abs(close - close[1])
float firstPass = ta.ema(rawRange, periodIn)
float secondPass = ta.ema(math.max(firstPass, 0.0), periodIn * 2 - 1)
float atrValue = ta.atr(atrLen)
float minimumRange = math.max(syminfo.mintick, nz(atrValue) * atrFloor)
float rangeWidth = na(secondPass) ? na : math.max(secondPass * multIn, minimumRange)
int warmupBars = math.max(periodIn * 3, atrLen)
bool ready = not na(close[1]) and not na(rangeWidth) and not na(atrValue) and bar_index >= warmupBars

var float filt = na
var float rangeOnClose = na
var bool readyOnClose = false
var int filterDirection = 0
var int flatBars = 0
var int lastStepDirection = 0
var float lastStepSource = na
int stepDirection = 0

if barstate.isconfirmed
    rangeOnClose := rangeWidth
    readyOnClose := ready
    if not ready
        filt := na
        filterDirection := 0
        flatBars := 0
        lastStepDirection := 0
        lastStepSource := na
    else
        float prevFilt = nz(filt, close)
        float candidate = close > prevFilt ? math.max(prevFilt, close - rangeWidth) : math.min(prevFilt, close + rangeWidth)
        // A shrinking range alone must not advance the filter.
        bool priceSupportsStep = candidate > prevFilt ? close > close[1] : candidate < prevFilt ? close < close[1] : true
        filt := priceSupportsStep ? candidate : prevFilt
        stepDirection := filt > prevFilt ? 1 : filt < prevFilt ? -1 : 0
        // A continuation needs actual price progress since the last step.
        if stepDirection != 0 and stepDirection == lastStepDirection
            bool newExtreme = stepDirection == 1 ? close > lastStepSource : close < lastStepSource
            if not newExtreme
                filt := prevFilt
                stepDirection := 0
        if stepDirection != 0
            lastStepDirection := stepDirection
            lastStepSource := close
        flatBars := stepDirection == 0 ? flatBars + 1 : 0
        if stepDirection != 0
            filterDirection := stepDirection
        else if flatBars >= rangeBars
            filterDirection := 0

// === MOVES: BUY -> FIN ===
var bool inMove = false
var float refPrice = na
var int buyBar = na
var int buyTime = na
var float mfe = na
var float mae = na
var float maeAtPeak = na
var label buyLabel = na
var box gainBox = na
var box dipBox = na
var zoneBoxes = array.new<box>()
var aMfe = array.new<float>()
var aMaePeak = array.new<float>()
var aRes = array.new<float>()
var aDur = array.new<int>()

bool buySignal = false
bool endSignal = false
string endReason = ""
float moveRes = na

pct(float x, string f) =>
    na(x) ? "n/a" : (x >= 0 ? "+" : "") + str.tostring(100.0 * x, f) + " %"

if barstate.isconfirmed
    if inMove
        // Dip before the peak = worst low on the bars before the new high.
        if high / refPrice - 1.0 > mfe
            maeAtPeak := mae
            mfe := high / refPrice - 1.0
        mae := math.min(mae, low / refPrice - 1.0)
        if showZones
            gainBox.set_right(bar_index)
            gainBox.set_top(refPrice * (1.0 + mfe))
            gainBox.set_text(mfe > 0 ? pct(mfe, "0.0") : "")
            dipBox.set_right(bar_index)
            dipBox.set_bottom(refPrice * (1.0 + mae))
            dipBox.set_text(mae < 0 ? pct(mae, "0.0") : "")
        if stepDirection == -1 or flatBars >= rangeBars
            endSignal := true
            endReason := stepDirection == -1 ? "inversion du filtre" : "plat prolonge"
            moveRes := close / refPrice - 1.0 - feeRt
            inMove := false
            int dur = bar_index - buyBar
            if showLabels
                buyLabel.set_text("BUY " + str.tostring(refPrice, format.mintick) + "\nmax " + pct(mfe, "0.0"))
                buyLabel.set_tooltip("Achat de reference : " + str.tostring(refPrice, format.mintick) + "\nMax atteint : " + pct(mfe, "0.00") + "\nBaisse avant le max : " + pct(maeAtPeak, "0.00") + "\nPire baisse : " + pct(mae, "0.00") + "\nResultat a FIN apres frais : " + pct(moveRes, "0.00") + "\nDuree : " + str.tostring(dur) + " bougies")
            if buyTime >= statsStart
                aMfe.push(mfe)
                aMaePeak.push(maeAtPeak)
                aRes.push(moveRes)
                aDur.push(dur)
    else if readyOnClose and stepDirection == 1
        buySignal := true
        inMove := true
        refPrice := close
        buyBar := bar_index
        buyTime := time
        mfe := 0.0
        mae := 0.0
        maeAtPeak := 0.0
        if showLabels
            buyLabel := label.new(bar_index, low, "BUY\n" + str.tostring(close, format.mintick), yloc = yloc.belowbar, style = label.style_label_up, color = colUp, textcolor = color.black, size = szMain, tooltip = "Mouvement en cours depuis " + str.tostring(close, format.mintick))
        if showZones
            gainBox := box.new(bar_index, close, bar_index, close, border_color = color.new(colUp, 55), bgcolor = color.new(colUp, 82), text_color = fg, text_size = szMinor, text_halign = text.align_center, text_valign = text.align_top)
            dipBox := box.new(bar_index, close, bar_index, close, border_color = color.new(colDown, 65), bgcolor = color.new(colDown, 86), text_color = fg, text_size = szMinor, text_halign = text.align_center, text_valign = text.align_bottom)
            zoneBoxes.push(gainBox)
            zoneBoxes.push(dipBox)
            while zoneBoxes.size() > 2 * zonesKept
                zoneBoxes.shift().delete()

if showLabels and endSignal
    label.new(bar_index, high, "FIN " + pct(moveRes, "0.0"), yloc = yloc.abovebar, style = label.style_label_down, color = color.new(colFlat, 15), textcolor = color.white, size = szMinor, tooltip = "Fin du mouvement : " + endReason + "\nResultat si vendu ici, apres frais : " + pct(moveRes, "0.00") + "\nInformation, pas un ordre.")

// === DIRECTION TEST: +x before -x, from BUY closes vs every 5th close ===
// Counts per threshold k: slot k*2 = BUY starts, slot k*2+1 = baseline starts.
var tRef = array.new<float>()
var tBar = array.new<int>()
var tBuy = array.new<bool>()
var tS1 = array.new<int>()
var tS2 = array.new<int>()
var tS3 = array.new<int>()
var cUp = array.new<int>(6, 0)
var cN = array.new<int>(6, 0)

// Same bar touching both levels counts as down (conservative: OHLC hides the order).
resolve(array<int> st, int i, float ref, float x, bool isBuy, int k) =>
    int s = st.get(i)
    if s == -1
        s := low <= ref * (1.0 - x) ? 0 : high >= ref * (1.0 + x) ? 1 : -1
        if s != -1
            st.set(i, s)
            int slot = k * 2 + (isBuy ? 0 : 1)
            cN.set(slot, cN.get(slot) + 1)
            cUp.set(slot, cUp.get(slot) + s)
    s

track(float ref, bool isBuy) =>
    tRef.push(ref)
    tBar.push(bar_index)
    tBuy.push(isBuy)
    tS1.push(-1)
    tS2.push(-1)
    tS3.push(-1)

if barstate.isconfirmed
    int i = tRef.size() - 1
    while i >= 0
        float ref = tRef.get(i)
        bool isB = tBuy.get(i)
        int s1 = resolve(tS1, i, ref, thr1 / 100.0, isB, 0)
        int s2 = resolve(tS2, i, ref, thr2 / 100.0, isB, 1)
        int s3 = resolve(tS3, i, ref, thr3 / 100.0, isB, 2)
        if (s1 != -1 and s2 != -1 and s3 != -1) or bar_index - tBar.get(i) >= dirCap
            tRef.remove(i)
            tBar.remove(i)
            tBuy.remove(i)
            tS1.remove(i)
            tS2.remove(i)
            tS3.remove(i)
        i -= 1
    if readyOnClose and time >= statsStart
        if buySignal
            track(close, true)
        if bar_index % 5 == 0
            track(close, false)

// === VISUALS ===
color dirColor = filterDirection == 1 ? colUp : filterDirection == -1 ? colDown : colFlat
plot(filt, "Filtre (halo)", color = color.new(dirColor, 82), linewidth = lineWidth + 5, style = plot.style_linebr)
filtPlot = plot(filt, "Filtre", color = dirColor, linewidth = lineWidth, style = plot.style_linebr)
pricePlot = plot(close, "Prix (nuage)", display = display.none, editable = false)
fill(filtPlot, pricePlot, color = showCloud and not na(filt) ? color.new(dirColor, 88) : na, title = "Nuage de tendance")
plot(showBands ? filt + rangeOnClose : na, "Bande haute", color = color.new(dirColor, 60), style = plot.style_linebr)
plot(showBands ? filt - rangeOnClose : na, "Seuil d'inversion", color = color.new(dirColor, 45), style = plot.style_linebr)
plot(inMove and not showZones ? refPrice : na, "Prix du BUY", color = fgMuted, linewidth = 1, style = plot.style_linebr)
barcolor(colorBars ? dirColor : na)
plot(filterDirection, "Sens du filtre", display = display.data_window)
plot(rangeOnClose / close * 100.0, "Largeur (% du prix)", display = display.data_window)

// === WHAT TO DO NOW ===
// Close levels for the bar being judged. They reproduce the engine step exactly:
// up step <=> close > buyLevel, down step <=> close < finLevel. On a forming bar the
// filter state is the last confirmed one; on a closed last bar the levels are for
// the next bar, with the current width (approximate).
bool live = not barstate.isconfirmed
float rwNow = live ? rangeWidth : rangeOnClose
float prevClose = live ? close[1] : close
float buyLevel = na(filt) or na(rwNow) ? na : math.max(filt + rwNow, prevClose, lastStepDirection == 1 ? lastStepSource : prevClose)
float finLevel = na(filt) or na(rwNow) ? na : math.min(filt - rwNow, prevClose, lastStepDirection == -1 ? lastStepSource : prevClose)
bool previewBuy = live and ready and not inMove and close > buyLevel
bool previewFin = live and ready and inMove and (close < finLevel or (flatBars + 1 >= rangeBars and close <= buyLevel))
int sinceBuy = inMove ? bar_index - buyBar : na
float fromBuy = inMove ? close / refPrice - 1.0 : na
bool buyWindow = inMove and fromBuy <= lateMaxPct / 100.0 and (entryBars == 0 or sinceBuy <= entryBars)

const int ST_INIT = 0
const int ST_BUY = 1
const int ST_BUY_FORMING = 2
const int ST_IN = 3
const int ST_FIN_FORMING = 4
const int ST_DOWN = 5
const int ST_WAIT = 6
int state = not ready ? ST_INIT : previewFin ? ST_FIN_FORMING : buyWindow ? ST_BUY : inMove ? ST_IN : previewBuy ? ST_BUY_FORMING : filterDirection == -1 ? ST_DOWN : ST_WAIT
string stateWord = state == ST_INIT ? "INITIALISATION" : state == ST_BUY ? "ACHAT" : state == ST_BUY_FORMING ? "ACHAT ?" : state == ST_IN ? "EN COURS " + pct(fromBuy, "0.0") : state == ST_FIN_FORMING ? "FIN ?" : state == ST_DOWN ? "PAS D'ACHAT" : "ATTENTE"
color stateBg = state == ST_BUY ? colUp : state == ST_BUY_FORMING or state == ST_FIN_FORMING ? colAmber : state == ST_IN ? color.new(colUp, 65) : state == ST_DOWN ? colDown : colNeutral
color stateTxt = state == ST_BUY or state == ST_BUY_FORMING or state == ST_FIN_FORMING ? color.black : color.white
lvl(float x) =>
    str.tostring(x, format.mintick) + " (" + pct(x / close - 1.0, "0.0") + ")"
string stateLine = state == ST_INIT ? "historique trop court" : state == ST_BUY ? "BUY " + str.tostring(refPrice, format.mintick) + (sinceBuy == 0 ? ", a cette cloture" : ", il y a " + str.tostring(sinceBuy) + " b.") + "  |  prix " + pct(fromBuy, "0.0") : state == ST_BUY_FORMING ? "pas confirme : BUY si cloture > " + lvl(buyLevel) : state == ST_IN ? (fromBuy > lateMaxPct / 100.0 ? "deja " + pct(fromBuy, "0.0") + " depuis le BUY : trop tard" : "fenetre fermee (" + str.tostring(entryBars) + " b.)") + "  |  FIN si cloture < " + lvl(finLevel) : state == ST_FIN_FORMING ? (close < finLevel ? "FIN si cloture < " + lvl(finLevel) : "plat trop long : FIN si pas > " + lvl(buyLevel)) : "BUY si cloture > " + lvl(buyLevel)

bgcolor(showWindow and buyWindow ? color.new(colUp, 84) : showWindow and previewBuy ? color.new(colAmber, 80) : na, title = "Fenetre d'achat")

// Tag and levels live on the last bar only: deleted and redrawn on each update.
var label stateTag = na
var line buyLine = na
var line finLine = na
var label buyLineLbl = na
var label finLineLbl = na
if barstate.islast
    label.delete(stateTag)
    line.delete(buyLine)
    line.delete(finLine)
    label.delete(buyLineLbl)
    label.delete(finLineLbl)
    if showTag
        stateTag := label.new(bar_index + 2, close, stateWord + "\n" + stateLine, style = label.style_label_left, color = stateBg, textcolor = stateTxt, size = szBig, textalign = text.align_left)
    if showLevels and ready
        if not inMove and not na(buyLevel)
            buyLine := line.new(bar_index - 3, buyLevel, bar_index + 12, buyLevel, color = colUp, style = line.style_dashed, width = 2)
            buyLineLbl := label.new(bar_index + 12, buyLevel, "BUY si cloture > " + str.tostring(buyLevel, format.mintick), style = label.style_label_left, color = color.new(colUp, 20), textcolor = color.black, size = szMinor)
        if inMove and not na(finLevel)
            finLine := line.new(bar_index - 3, finLevel, bar_index + 12, finLevel, color = colDown, style = line.style_dashed, width = 2)
            finLineLbl := label.new(bar_index + 12, finLevel, "FIN si cloture < " + str.tostring(finLevel, format.mintick), style = label.style_label_left, color = color.new(colDown, 20), textcolor = color.white, size = szMinor)

// === ALERTS ===
// Create one alert with "Any alert() function call". Signals at bar close, not orders.
if buySignal
    alert(syminfo.ticker + " " + timeframe.period + " : BUY a " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if alertPreview and previewBuy
    alert(syminfo.ticker + " " + timeframe.period + " : BUY en formation, confirme si cloture > " + str.tostring(buyLevel, format.mintick), alert.freq_once_per_bar)
if endSignal
    alert(syminfo.ticker + " " + timeframe.period + " : FIN du mouvement (" + endReason + "), " + pct(moveRes, "0.00") + " depuis le BUY", alert.freq_once_per_bar_close)

// === PANELS ===
var table liveTable = table.new(position.top_right, 2, 6, bgcolor = panelBg, frame_color = panelLine, frame_width = 1, border_color = panelLine, border_width = 1)
var table statsTable = table.new(position.bottom_right, 3, 13, bgcolor = panelBg, frame_color = panelLine, frame_width = 1, border_color = panelLine, border_width = 1)

cell(table t, int c, int r, string s, color col, color bg = na) =>
    table.cell(t, c, r, s, text_color = col, bgcolor = bg, text_size = szMain, text_halign = text.align_left)

med(array<float> a) =>
    a.size() > 0 ? a.median() : na

avg(array<float> a) =>
    a.size() > 0 ? a.avg() : na

shareOf(int up, int n) =>
    n > 0 ? 100.0 * up / n : na

// Gap between the BUY share and the baseline share, in standard errors (two proportions).
zOf(int k) =>
    int n1 = cN.get(k * 2)
    int n0 = cN.get(k * 2 + 1)
    float p1 = n1 > 0 ? float(cUp.get(k * 2)) / n1 : na
    float p0 = n0 > 0 ? float(cUp.get(k * 2 + 1)) / n0 : na
    na(p1) or na(p0) or p0 <= 0.0 or p0 >= 1.0 ? na : (p1 - p0) / math.sqrt(p0 * (1.0 - p0) * (1.0 / n1 + 1.0 / n0))

zColor(float z) =>
    na(z) ? fg : z >= 2.0 ? colUp : z <= -2.0 ? colDown : fg

leftText(int ms) =>
    int m = int(math.ceil(math.max(ms, 0) / 60000.0))
    m >= 60 ? str.tostring(int(m / 60)) + " h " + str.format("{0,number,00}", m % 60) : str.tostring(m) + " min"

if barstate.islast and showLive
    table.cell(liveTable, 0, 0, stateWord, text_color = stateTxt, bgcolor = stateBg, text_size = szBig, text_halign = text.align_center)
    table.cell(liveTable, 0, 1, stateLine, text_color = fg, text_size = szMain, text_halign = text.align_center)
    cell(liveTable, 0, 2, "Cloture de la bougie", fgMuted)
    cell(liveTable, 1, 2, live and not na(time_close) ? "dans " + leftText(time_close - timenow) : "fermee", fg)
    if inMove
        cell(liveTable, 0, 3, "Depuis BUY : actuel / max / pire", fgMuted)
        cell(liveTable, 1, 3, pct(fromBuy, "0.00") + "  /  " + pct(math.max(mfe, high / refPrice - 1.0), "0.0") + "  /  " + pct(math.min(mae, low / refPrice - 1.0), "0.0"), fromBuy >= 0 ? colUp : colDown)
    else
        cell(liveTable, 0, 3, "Filtre", fgMuted)
        cell(liveTable, 1, 3, filterDirection == -1 ? "▼ baisse" : "■ plat", dirColor)
    if walletIn > 0
        float amount = walletIn * sizePct / 100.0
        cell(liveTable, 0, 4, "Montant (" + str.tostring(sizePct, "0.#") + " %)", fgMuted)
        cell(liveTable, 1, 4, str.tostring(amount, "#,##0.00") + " " + syminfo.currency + "  =  " + str.tostring(amount / close, "#,##0.####") + " " + syminfo.basecurrency, fg)
    // Honesty line: does a BUY here beat buying at any bar? (detail in the stats panel)
    int nB = cN.get(2)
    float zB = zOf(1)
    string tB = str.tostring(thr2, "0.#") + " %"
    cell(liveTable, 0, 5, "Historique : +" + tB + " avant -" + tB, fgMuted)
    cell(liveTable, 1, 5, nB < 30 or na(zB) ? "pas assez de BUY (" + str.tostring(nB) + ")" : zB >= 2.0 ? "BUY mieux que le hasard" : zB >= 1.0 ? "un peu mieux, pas prouve" : zB > -1.0 ? "BUY = hasard ici" : "BUY moins bien que le hasard", nB < 30 or na(zB) ? fgMuted : zB >= 2.0 ? colUp : zB >= 1.0 ? colAmber : zB > -1.0 ? fg : colDown)

// Merge once: merged cells cannot be merged again.
if barstate.isfirst
    liveTable.merge_cells(0, 0, 1, 0)
    liveTable.merge_cells(0, 1, 1, 1)
    statsTable.merge_cells(0, 0, 2, 0)
    statsTable.merge_cells(0, 1, 2, 1)
    statsTable.merge_cells(0, 6, 2, 6)
    statsTable.merge_cells(0, 12, 2, 12)

if barstate.islast and showStats
    int nBuy = cN.get(2)
    float z = zOf(1)
    string thrTxt = str.tostring(thr2, "0.#") + " %"
    string verdict = nBuy < 30 ? "Trop peu de BUY pour juger (n = " + str.tostring(nBuy) + ")" : na(z) ? "Pas de comparaison possible" : z >= 2.0 ? "AVANTAGE : apres un BUY, +" + thrTxt + " vient avant -" + thrTxt + " plus souvent" : z >= 1.0 ? "Leger mieux que le hasard, pas prouve" : z > -1.0 ? "AUCUN AVANTAGE : comme acheter a n'importe quelle bougie" : z > -2.0 ? "Un peu moins bien que le hasard" : "PIRE que le hasard"
    color verdictBg = nBuy < 30 or na(z) ? colNeutral : z >= 2.0 ? colUp : z >= 1.0 ? colAmber : z > -1.0 ? colNeutral : colDown
    cell(statsTable, 0, 0, "Ce qu'ont donne les BUY, depuis " + str.format_time(statsStart, "yyyy-MM-dd"), fg)
    cell(statsTable, 0, 1, verdict + (nBuy < 30 or na(z) ? "" : "  (z = " + str.tostring(z, "0.0") + ", n = " + str.tostring(nBuy) + ")"), nBuy >= 30 and not na(z) and z >= 1.0 ? color.black : color.white, verdictBg)
    cell(statsTable, 0, 2, "Apres un BUY, d'abord :", fgMuted)
    cell(statsTable, 1, 2, "BUY", fg)
    cell(statsTable, 2, 2, "N'importe quand", fgMuted)
    array<float> thrs = array.from(thr1, thr2, thr3)
    for k = 0 to 2
        string t = str.tostring(thrs.get(k), "0.#") + " %"
        float zk = zOf(k)
        cell(statsTable, 0, 3 + k, "+" + t + " avant -" + t, fgMuted)
        cell(statsTable, 1, 3 + k, na(shareOf(cUp.get(k * 2), cN.get(k * 2))) ? "n/a" : str.tostring(shareOf(cUp.get(k * 2), cN.get(k * 2)), "0") + " %", zColor(zk))
        cell(statsTable, 2, 3 + k, na(shareOf(cUp.get(k * 2 + 1), cN.get(k * 2 + 1))) ? "n/a" : str.tostring(shareOf(cUp.get(k * 2 + 1), cN.get(k * 2 + 1)), "0") + " %", fgMuted)
    cell(statsTable, 0, 6, "Mouvements BUY -> FIN (descriptif)", fgMuted)
    int n = aMfe.size()
    cell(statsTable, 0, 7, "Mouvements termines", fgMuted)
    cell(statsTable, 1, 7, str.tostring(n), fg)
    cell(statsTable, 0, 8, "Max atteint (mediane)", fgMuted)
    cell(statsTable, 1, 8, pct(med(aMfe), "0.00"), fg)
    cell(statsTable, 0, 9, "Baisse avant le max (mediane)", fgMuted)
    cell(statsTable, 1, 9, pct(med(aMaePeak), "0.00"), fg)
    cell(statsTable, 0, 10, "Si vendu a FIN, apres frais (moy.)", fgMuted)
    cell(statsTable, 1, 10, pct(avg(aRes), "0.00"), fg)
    cell(statsTable, 0, 11, "Duree (mediane)", fgMuted)
    cell(statsTable, 1, 11, aDur.size() > 0 ? str.tostring(aDur.median(), "0") + " bougies" : "n/a", fg)
    for r = 7 to 11
        cell(statsTable, 2, r, "", fgMuted)
    cell(statsTable, 0, 12, "Reference : une bougie sur 5. Historique charge seulement. Passe =/= futur.", fgMuted)
